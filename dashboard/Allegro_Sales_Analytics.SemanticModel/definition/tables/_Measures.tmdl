table _Measures
	lineageTag: 8fbd4b36-2505-402f-af44-f7011e7cd0a8

	measure Revenue = CALCULATE ( SUM ( orders[revenue_pln] ), orders[order_status] = "Delivered" )
		formatString: #,0 zł
		displayFolder: 1. Core
		lineageTag: 7c1c8efa-da14-4cab-b205-4d75f5fa1cec

	measure Orders = CALCULATE ( COUNTROWS ( orders ), orders[order_status] = "Delivered" )
		formatString: #,0
		displayFolder: 1. Core
		lineageTag: 52e73b6c-f4e6-4c84-8194-eabda454f79f

	measure 'All Orders' = COUNTROWS ( orders )
		formatString: #,0
		displayFolder: 1. Core
		lineageTag: 5c97c804-3eb4-4e34-9355-c73119e7d8d1

	measure 'Units Sold' = CALCULATE ( SUM ( orders[quantity] ), orders[order_status] = "Delivered" )
		formatString: #,0
		displayFolder: 1. Core
		lineageTag: 72ff4a8f-2339-4c0e-84b0-92b24b53dcd4

	measure 'Avg Order Value' = DIVIDE ( [Revenue], [Orders] )
		formatString: #,0.00 zł
		displayFolder: 1. Core
		lineageTag: b1cb2282-bcba-42e7-a0d1-a26218c243e1

	measure 'Return Rate %' = DIVIDE ( CALCULATE ( COUNTROWS ( orders ), orders[order_status] = "Returned" ), [All Orders] )
		formatString: 0.0%
		displayFolder: 1. Core
		lineageTag: baab56fa-095e-426e-8d82-5d7659ee50e6

	measure 'Cancel Rate %' = DIVIDE ( CALCULATE ( COUNTROWS ( orders ), orders[order_status] = "Cancelled" ), [All Orders] )
		formatString: 0.0%
		displayFolder: 1. Core
		lineageTag: 6c46a744-dce2-4486-bec2-8a7b57bb3f1a

	measure 'Revenue Share %' = DIVIDE ( [Revenue], CALCULATE ( [Revenue], ALLSELECTED ( orders ) ) )
		formatString: 0.0%
		displayFolder: 1. Core
		lineageTag: d9440084-1b29-4f66-b5bb-35fea13221c5

	measure 'Electronics Share %' = DIVIDE ( CALCULATE ( [Revenue], orders[category] = "Electronics" ), [Revenue] )
		formatString: 0.0%
		displayFolder: 1. Core
		lineageTag: a82dd4f0-7240-49e2-982c-b8670fa7ea2f

	measure 'Large Orders Share %' = DIVIDE ( CALCULATE ( [Revenue], orders[value_band_order] = 3 ), [Revenue] )
		formatString: 0.0%
		displayFolder: 1. Core
		lineageTag: 9f994356-5dbb-4806-bb6c-e8ce9dae4356

	measure 'Warsaw Share %' = DIVIDE ( CALCULATE ( [Revenue], orders[customer_city] = "Warszawa" ), [Revenue] )
		formatString: 0.0%
		displayFolder: 1. Core
		lineageTag: 0c124f46-e189-4fbd-9111-27b4004fe015

	measure 'Paczkomat Share %' = DIVIDE ( CALCULATE ( [Orders], orders[delivery_method] = "Paczkomat InPost" ), [Orders] )
		formatString: 0.0%
		displayFolder: 1. Core
		lineageTag: cbc38261-fee3-4133-802c-b7cbe44649f3

	measure 'BLIK Share %' = DIVIDE ( CALCULATE ( [Orders], orders[payment_method] = "BLIK" ), [Orders] )
		formatString: 0.0%
		displayFolder: 1. Core
		lineageTag: 209c6443-d5e6-4eed-8f0d-247c71fef0f0

	measure 'Pay Later Share %' = DIVIDE ( CALCULATE ( [Orders], orders[payment_method] = "Pay later" ), [Orders] )
		formatString: 0.0%
		displayFolder: 1. Core
		lineageTag: 4e152b1f-3876-4462-88b5-24396ffa412d

	measure Cities = CALCULATE ( DISTINCTCOUNT ( orders[customer_city] ), orders[customer_city] <> "Unknown" )
		formatString: #,0
		displayFolder: 1. Core
		lineageTag: 6405f5e3-026c-43f4-8af6-476024ea682e

	measure 'Top Category' = MAXX ( TOPN ( 1, VALUES ( orders[category] ), [Revenue] ), orders[category] )
		displayFolder: 4. Labels
		lineageTag: 6f71393d-25d3-4495-a40c-e16b784b2616

	measure 'Top Product' = MAXX ( TOPN ( 1, VALUES ( orders[product_name] ), [Revenue] ), orders[product_name] )
		displayFolder: 4. Labels
		lineageTag: ce671553-8320-49e6-8e7b-4c8b83f5ffc9

	measure 'Top City' = MAXX ( TOPN ( 1, VALUES ( orders[customer_city] ), [Revenue] ), orders[customer_city] )
		displayFolder: 4. Labels
		lineageTag: c75aedfe-1146-4bad-b559-d4cba3fc0e89

	measure 'Top Region' = MAXX ( TOPN ( 1, VALUES ( orders[region] ), [Revenue] ), orders[region] )
		displayFolder: 4. Labels
		lineageTag: 66216184-9938-4ec7-8093-6b7a5a4bce3d

	measure Target = IF ( ISFILTERED ( orders[category] ) || ISFILTERED ( orders[product_name] ) || ISFILTERED ( orders[customer_city] ) || ISFILTERED ( orders[region] ) || ISFILTERED ( orders[payment_method] ) || ISFILTERED ( orders[delivery_method] ) || ISFILTERED ( orders[order_status] ) || ISFILTERED ( orders[value_band] ), BLANK (), SUM ( targets[target_pln] ) )
		formatString: #,0 zł
		displayFolder: 2. Target
		lineageTag: af83bbd7-0b4d-4ea6-821c-c10c144fa37e

	measure 'Achievement %' = DIVIDE ( [Revenue], [Target] )
		formatString: 0.0%
		displayFolder: 2. Target
		lineageTag: 141ea634-17b3-49e0-b086-fa23dfe5ca4b

	measure 'Variance vs Target' = IF ( NOT ISBLANK ( [Target] ), [Revenue] - [Target] )
		formatString: #,0 zł;-#,0 zł
		displayFolder: 2. Target
		lineageTag: 3d83ea75-3ef3-4712-838c-c40b59587f39

	measure 'Revenue YTD' = TOTALYTD ( [Revenue], 'Calendar'[Date] )
		formatString: #,0 zł
		displayFolder: 3. Time
		lineageTag: 0cd1830c-7b1d-4e0d-9ae3-1a67632ed979

	measure 'Target YTD' = TOTALYTD ( [Target], 'Calendar'[Date] )
		formatString: #,0 zł
		displayFolder: 3. Time
		lineageTag: 70517574-1ef7-4479-8ead-c6b82ca7e357

	measure 'Achievement Color' = SWITCH ( TRUE (), ISBLANK ( [Achievement %] ), "#6B6B70", [Achievement %] >= 1, "#1E8E5A", [Achievement %] >= 0.95, "#B57600", "#D7141A" )
		displayFolder: 5. Formatting
		lineageTag: 096563d1-cddc-4e81-afa3-c2a623e251bb

	measure 'Achievement Label' = IF ( ISBLANK ( [Target] ), "target n/a", "target " & FORMAT ( [Target], "#,0" ) & " zł" )
		displayFolder: 4. Labels
		lineageTag: bf577f2e-1c38-4a82-84f6-698882d1b09e

	measure 'Revenue PY' = CALCULATE ( [Revenue], SAMEPERIODLASTYEAR ( 'Calendar'[Date] ) )
		displayFolder: 3. Time
		lineageTag: f3142160-d30a-4063-9728-8190189005bc

	measure 'Revenue vs PY' =
			VAR _c = [Revenue]
			VAR _p = [Revenue PY]
			RETURN
				IF ( NOT HASONEVALUE ( 'Calendar'[Year] ), "2024–2025 total",
					IF ( ISBLANK ( _p ), "no prior year", "vs PY  " & IF ( _c >= _p, "▲ ", "▼ " ) & FORMAT ( DIVIDE ( _c - _p, _p ), "+0.0%;-0.0%" ) ) )
		displayFolder: 4. Labels
		lineageTag: b5aad1ae-8e64-45a5-a09c-8d7a47124876

	measure 'Revenue vs PY Color' =
			VAR _c = [Revenue]
			VAR _p = [Revenue PY]
			RETURN
				IF ( NOT HASONEVALUE ( 'Calendar'[Year] ) || ISBLANK ( _p ), "#6B6B70", IF ( _c >= _p, "#1E8E5A", "#D7141A" ) )
		displayFolder: 5. Formatting
		lineageTag: 9f216048-bce2-490d-871e-f76366070e40

