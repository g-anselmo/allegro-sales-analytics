	partition orders = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "clean\orders_clean.csv"), [Delimiter=",", Columns=12, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"order_id", Int64.Type}, {"order_date", type date}, {"category", type text}, {"product_name", type text}, {"unit_price_pln", type number}, {"quantity", Int64.Type}, {"customer_city", type text}, {"region", type text}, {"payment_method", type text}, {"delivery_method", type text}, {"order_status", type text}, {"revenue_pln", type number}}, "en-US"),
				    PaymentNull = Table.ReplaceValue(Typed, null, "Unknown", Replacer.ReplaceValue, {"payment_method"}),
				    Payment = Table.ReplaceValue(PaymentNull, "", "Unknown", Replacer.ReplaceValue, {"payment_method"}),
				    AddBand = Table.AddColumn(Payment, "value_band", each if [revenue_pln] = null then "No quantity" else if [revenue_pln] < 100 then "Small (<100 zł)" else if [revenue_pln] < 1000 then "Medium (100–999 zł)" else "Large (1,000+ zł)", type text),
				    AddBandOrder = Table.AddColumn(AddBand, "value_band_order", each if [revenue_pln] = null then 4 else if [revenue_pln] < 100 then 1 else if [revenue_pln] < 1000 then 2 else 3, Int64.Type)
				in
				    AddBandOrder

	annotation PBI_ResultType = Table

